---
username: "replace-me"
password: "replace-me"
model: "ios"
interval: 3600
use_syslog: false
debug: false
threads: 30
timeout: 20
retries: 3
prompt: !ruby/regexp /^([\w.@()-]+[#>]\s?)$/
rest: 127.0.0.1:8888
next_adds_job: true
vars: {}
source:
  default: http
  debug: false
  http:
    url: http://librenms/api/v0/oxidized
    map:
      name: hostname
      model: os
      group: group
    headers:
      X-Auth-Token: "replace-with-librenms-api-token"
output:
  default: git
  git:
    user: LibreNMS
    email: librenms@example.invalid
repo:
  default: /root/.config/oxidized/output/configs.git
hooks: {}
