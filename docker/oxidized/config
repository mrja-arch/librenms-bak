---
username: "__OXIDIZED_USERNAME__"
password: "__OXIDIZED_PASSWORD__"
model: "vrp"
interval: 3600
use_syslog: false
debug: false
threads: 30
timeout: 20
retries: 3
prompt: !ruby/regexp /^([\w.@()-]+[#>]\s?)$/
rest: 0.0.0.0:8888
next_adds_job: true
vars: {}
source:
  default: http
  debug: false
  http:
    url: http://librenms:8000/api/v0/oxidized
    map:
      name: hostname
      model: os
      group: group
    headers:
      X-Auth-Token: "__OXIDIZED_API_TOKEN__"
output:
  default: git
  git:
    user: LibreNMS
    email: librenms@example.invalid
    repo: /home/oxidized/.config/oxidized/output/configs.git
hooks: {}
