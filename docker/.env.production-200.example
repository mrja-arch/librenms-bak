COMPOSE_PROJECT_NAME=librenms
TZ=Asia/Shanghai
PUID=1000
PGID=1000

LIBRENMS_CUSTOM_IMAGE=mrja/librenms:26.5.1-custom
WEB_PORT=8000
APP_URL=http://librenms.example.com:8000

DB_DATABASE=librenms
DB_USERNAME=librenms
DB_PASSWORD=replace-with-a-long-random-password
DB_TIMEOUT=60

DISPATCHER_NODE_ID=dispatcher-production-200
SNMPTRAP_PORT=162
SNMP_TRAP_COMMUNITY=replace-with-read-only-community

OXIDIZED_USERNAME=librenms-ro
OXIDIZED_PASSWORD=replace-with-device-read-only-password
OXIDIZED_API_TOKEN=replace-with-librenms-api-token
DIAGNOSTIC_SSH_USERNAME=librenms-ro
DIAGNOSTIC_SSH_PASSWORD=replace-with-device-read-only-password
